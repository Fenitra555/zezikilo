### ============================================
### VARIABLES GLOBALES
### ============================================
@baseUrl = http://localhost:3000


### ============================================
### 1. HEALTH CHECK
### ============================================
GET {{baseUrl}}/api/health


### ============================================
### 2. REGISTER ALICE (une seule fois)
### ============================================
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "aliceMotDePasse",
  "fullName": "Alice Test"
}


### ============================================
### 3. LOGIN ALICE
### ============================================
# @name loginAlice
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "aliceMotDePasse"
}


### ============================================
### 4. CREER UN APPAREIL
### ============================================
# @name createDevice
POST {{baseUrl}}/api/devices
Authorization: Bearer {{loginAlice.response.body.data.token}}
Content-Type: application/json

{
  "serialNumber": "test00000001",
  "alias": "Composteur Cuisine"
}


### ============================================
### 5. AJOUTER UNE MESURE (temp: 58.5)
### ============================================
POST {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/measurements
Authorization: Bearer {{loginAlice.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 58.5,
  "humidity": 47.2,
  "motor": true,
  "fan": false,
  "phase": 1,
  "emergency": false
}


### ============================================
### 6. AJOUTER UNE MESURE (temp: 62.1)
### ============================================
POST {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/measurements
Authorization: Bearer {{loginAlice.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 62.1,
  "humidity": 51.0,
  "motor": true,
  "fan": true,
  "phase": 2,
  "emergency": false
}


### ============================================
### 7. AJOUTER UNE MESURE (temp: 45.3)
### ============================================
POST {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/measurements
Authorization: Bearer {{loginAlice.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 45.3,
  "humidity": 49.5,
  "motor": false,
  "fan": false,
  "phase": 3,
  "emergency": false
}


### ============================================
### 8. LISTER LES MESURES
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/measurements
Authorization: Bearer {{loginAlice.response.body.data.token}}


### ============================================
### 9. LISTER LES APPAREILS
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{loginAlice.response.body.data.token}}