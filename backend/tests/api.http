### ============================================
### VARIABLES GLOBALES
### ============================================
@baseUrl = http://localhost:3000


### ============================================
### 1. HEALTH CHECK
### ============================================
GET {{baseUrl}}/api/health


### ============================================
### 2. INSCRIPTION (à exécuter une seule fois)
### ============================================
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "george.dupont@example.com",
  "password": "monMotDePasse123",
  "fullName": "George Dupont"
}


### ============================================
### 3. CONNEXION - Capture automatique du token
### ============================================
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jean.dupont@example.com",
  "password": "monMotDePasse123"
}


### ============================================
### 4. LISTE DES APPAREILS (utilise le token capturé)
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 5. AJOUTER UN APPAREIL - Capture automatique du deviceId
### ============================================
# @name createDevice
POST {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "serialNumber": "a0b7c8d9e0f1",
  "alias": "Composteur Jardin"
}


### ============================================
### 6. DÉTAIL D'UN APPAREIL (utilise le deviceId capturé)
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 7. MODIFIER L'ALIAS D'UN APPAREIL
### ============================================
PUT {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "alias": "Composteur Potager"
}


### ============================================
### 8. VÉRIFIER LA MODIFICATION
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 9. SUPPRIMER L'APPAREIL
### ============================================
DELETE {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}
