### ============================================
### VARIABLES GLOBALES
### ============================================
@baseUrl = http://localhost:3000


### ============================================
### 1. HEALTH CHECK
### ============================================
GET {{baseUrl}}/api/health


### ============================================
### 2. INSCRIPTION JEAN
### ============================================
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "jean.dupont@example.com",
  "password": "monMotDePasse123",
  "fullName": "Jean Dupont"
}


### ============================================
### 3. LOGIN JEAN
### ============================================
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jean.dupont@example.com",
  "password": "monMotDePasse123"
}


### ============================================
### 4. CREER APPAREIL COMPOSTEUR
### ============================================
# @name createDevice
POST {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "serialNumber": "a0b7c8d9e0f1",
  "alias": "Composteur Jardin"
}


### ============================================
### 5. INSCRIPTION MARIE
### ============================================
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "marie.dupont@example.com",
  "password": "monMotDePasse456",
  "fullName": "Marie Dupont"
}


### ============================================
### 6. LISTER LES PERMISSIONS (vide au départ)
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 7. PARTAGER AVEC MARIE (read)
### ============================================
POST {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "email": "marie.dupont@example.com",
  "permission": "read"
}


### ============================================
### 8. VERIFIER
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 9. LOGIN MARIE
### ============================================
# @name loginMarie
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "marie.dupont@example.com",
  "password": "monMotDePasse456"
}


### ============================================
### 10. APPAREILS DE MARIE (doit voir le partagé)
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{loginMarie.response.body.data.token}}


### ============================================
### 11. MODIFIER PERMISSION MARIE (read -> write)
### ============================================
### Remplacer USER_ID par l'ID de Marie (visible en requête 8)
PUT {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions/21ef1c69-2067-4ab7-a41a-6c9a0f3085f8
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "permission": "write"
}

### ============================================
### 12. REVOQUER ACCES MARIE
### ============================================
### Remplacer USER_ID par l'ID de Marie
DELETE {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions/21ef1c69-2067-4ab7-a41a-6c9a0f3085f8
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 13. VERIFIER (liste vide)
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}/permissions
Authorization: Bearer {{login.response.body.data.token}}