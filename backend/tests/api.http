### ============================================
### VARIABLES GLOBALES
### ============================================
@baseUrl = http://localhost:3000


### ============================================
### 1. HEALTH CHECK
### ============================================
GET {{baseUrl}}/api/health


### ============================================
### 2. INSCRIPTION (à exécuter une seule fois)
### ============================================
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "george.dupont@example.com",
  "password": "monMotDePasse123",
  "fullName": "George Dupont"
}


### ============================================
### 3. CONNEXION - Capture automatique du token
### ============================================
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jean.dupont@example.com",
  "password": "monMotDePasse123"
}


### ============================================
### 4. LISTE DES APPAREILS (utilise le token capturé)
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 5. AJOUTER UN APPAREIL - Capture automatique du deviceId
### ============================================
# @name createDevice
POST {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "serialNumber": "a0b7c8d9e0f1",
  "alias": "Composteur Jardin"
}


### ============================================
### 6. DÉTAIL D'UN APPAREIL (utilise le deviceId capturé)
### ============================================
GET {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 7. MODIFIER L'ALIAS D'UN APPAREIL
### ============================================
PUT {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "alias": "Composteur Potager"
}


### ============================================
### 8. VÉRIFIER LA MODIFICATION
### ============================================
GET {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}


### ============================================
### 9. SUPPRIMER L'APPAREIL
### ============================================
DELETE {{baseUrl}}/api/devices/{{createDevice.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 10. RECRÉER UN APPAREIL POUR LES MESURES
### ============================================
# @name createDeviceForMeasurements
POST {{baseUrl}}/api/devices
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "serialNumber": "b1c2d3e4f5a6",
  "alias": "Composteur Mesures"
}


### ============================================
### 11. AJOUTER DES MESURES (pour test)
### ============================================
POST {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 55.5,
  "humidity": 48.2,
  "motor": true,
  "fan": false,
  "phase": 1,
  "emergency": false
}

### ============================================
### 12. AJOUTER UNE DEUXIÈME MESURE
### ============================================
POST {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 58.3,
  "humidity": 50.1,
  "motor": true,
  "fan": false,
  "phase": 1,
  "emergency": false
}

### ============================================
### 13. AJOUTER UNE TROISIÈME MESURE
### ============================================
POST {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "temperature": 61.0,
  "humidity": 52.0,
  "motor": true,
  "fan": true,
  "phase": 2,
  "emergency": false
}

### ============================================
### 14. HISTORIQUE COMPLET (les 3 mesures)
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 15. HISTORIQUE AVEC LIMITE (2 mesures)
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements?limit=2&offset=0
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 16. HISTORIQUE AVEC PAGINATION (page 2)
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements?limit=2&offset=2
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 17. HISTORIQUE FILTRÉ PAR DATE
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/measurements?startDate=0
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 18. RÉCUPÉRER LES PARAMÈTRES PAR DÉFAUT
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/settings
Authorization: Bearer {{login.response.body.data.token}}

### ============================================
### 19. METTRE À JOUR LES PARAMÈTRES
### ============================================
PUT {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/settings
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
  "tempMaxUrgence": 70.0,
  "humiditeMin": 35.0,
  "dureeBrassagePhase1": 4
}

### ============================================
### 20. VÉRIFIER LA MISE À JOUR
### ============================================
GET {{baseUrl}}/api/devices/{{createDeviceForMeasurements.response.body.data.id}}/settings
Authorization: Bearer {{login.response.body.data.token}}